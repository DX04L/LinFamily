rules_version = '2';
// LinFamily｜Firestore 規則（請到 Firebase Console → Firestore → 規則 貼上並發布）
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function supers() { return ['darren710404@gmail.com', 'darren.lin@twclc.org']; }
    function isSuper() { return signedIn() && myEmail() in supers(); }
    function memberDoc() { return get(/databases/$(database)/documents/admin_users/$(myEmail())); }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/admin_users/$(myEmail()))
        && memberDoc().data.get('active', true) == true
        && memberDoc().data.role in ['admin', 'viewer', 'user'];
    }
    function isAdmin() { return isSuper() || (isMember() && memberDoc().data.role == 'admin'); }

    // 權限名單：自己可讀自己的；只有 Superuser 可列出、新增、修改（含強制登出 forceLogoutAt）、刪除
    match /admin_users/{email} {
      allow get: if signedIn() && (myEmail() == email || isSuper());
      allow list, delete: if isSuper();
      allow create, update: if isSuper()
        && email == email.lower()
        && !(email in supers())
        && request.resource.data.keys().hasOnly(['role', 'active', 'updatedAt', 'forceLogoutAt'])
        && request.resource.data.role in ['admin', 'viewer', 'user']
        && request.resource.data.active is bool;
    }

    // 設定：apps（App 櫃＝全部 App）、security（休眠與自動登出）。大家可讀（沒登入也要讀）；只有 Superuser 可改
    match /linfamily_settings/{doc} {
      allow read: if true;
      allow write: if isSuper();
    }

    // 個人桌面（主畫面排列、背景主題）：只有本人（且在名單內）可讀寫；Superuser 可讀寫全部
    match /linfamily_desktops/{email} {
      allow read, write: if isSuper() || (isMember() && myEmail() == email);
    }

    // 共用桌面排列（shared/desktop）：users/{uid}/desktop/{desktop|phone}，只有本人可讀寫
    match /users/{uid}/desktop/{device} {
      allow read, write: if signedIn() && request.auth.uid == uid && device in ['desktop', 'phone']
        && (isSuper() || isMember());
    }

    // Hannah's Studio 作品：大家可看；Superuser、Admin 可新增、修改、刪除
    match /hannah_artworks/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Daily QT 每日靈修：大家可讀（免登入）；只有 Superuser 或後端自動化腳本可寫入
    match /devotionals/{date} {
      allow read: if true;
      allow write: if isSuper();
    }

    // QT marks are private to the UID in the path. Each document holds one mark.
    match /qt_readers/{uid}/annotations/{annotationId} {
      function ownsAnnotations() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validAnnotation() {
        let data = request.resource.data;
        return data.keys().hasAll(['entry', 'payload'])
          && data.keys().hasOnly(['entry', 'payload'])
          && data.entry is string && data.entry.size() > 0 && data.entry.size() <= 240
          && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 40000
          && annotationId.matches('[0-9a-f-]{36}');
      }
      allow get, list: if ownsAnnotations();
      allow create: if ownsAnnotations() && validAnnotation();
      allow update: if ownsAnnotations() && validAnnotation()
        && request.resource.data.entry == resource.data.entry;
    }

    // 小組牧養教材：所有人可讀取；僅後端 Python 腳本 (Admin SDK) 或 Superuser 可寫入與刪除過期教材
    match /sg_discussions/{date} {
      allow read: if true;
      allow write: if isSuper();
    }

    // 小組教材個人反白與註記：僅登入本人可讀寫與刪除自己的標記
    match /sg_readers/{uid}/annotations/{annotationId} {
      function ownsSgAnnotations() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSgAnnotation() {
        let data = request.resource.data;
        return data.keys().hasAll(['entry', 'payload'])
          && data.keys().hasOnly(['entry', 'payload'])
          && data.entry is string && data.entry.size() > 0 && data.entry.size() <= 300
          && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 40000
          && annotationId.matches('[0-9a-f-]{36}');
      }
      allow get, list: if ownsSgAnnotations();
      allow create: if ownsSgAnnotations() && validSgAnnotation();
      allow update: if ownsSgAnnotations() && validSgAnnotation()
        && request.resource.data.entry == resource.data.entry;
      allow delete: if ownsSgAnnotations();
    }

    // Pinky Jump mobile controller: separate anonymous access only for this room.
    // One-hour rooms, non-listable; controller can send commands, host can publish phase.
    match /pinky_jump_rooms/{room} {
      function validCode() { return room.matches('[A-HJ-NP-Z2-9]{6}'); }
      function fresh() {
        return resource.data.createdAt is timestamp
          && resource.data.createdAt > request.time - duration.value(1, 'h');
      }
      allow get: if request.auth != null && validCode() && fresh();
      allow list, delete: if false;
      allow create: if request.auth != null && validCode()
        && request.resource.data.keys().hasOnly([
          'host','controller','action','seq','power','playerName',
          'phase','runScore','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'host','controller','action','seq','power','playerName',
          'phase','runScore','createdAt','updatedAt'
        ])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.controller == ''
        && request.resource.data.action == 'waiting'
        && request.resource.data.seq == 0
        && request.resource.data.power == 0
        && request.resource.data.playerName == ''
        && request.resource.data.phase == 'ready'
        && request.resource.data.runScore == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && validCode() && fresh()
        && (
          // Host can only report game phase/score. Cannot impersonate controller.
          (resource.data.host == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'phase','runScore','updatedAt'
            ])
            && request.resource.data.phase in [
              'ready','playing','gameover','record','record_error','submitted'
            ]
            && request.resource.data.runScore is int
            && request.resource.data.runScore >= 0
            && request.resource.data.runScore <= 9999999
            && request.resource.data.updatedAt == request.time)
          ||
          // First matching phone may claim the room; only that UID can send later.
          // A room idle for 60s can be claimed by another phone (e.g. the old one was closed).
          ((resource.data.controller == '' ||
              resource.data.controller == request.auth.uid ||
              resource.data.updatedAt < request.time - duration.value(60, 's'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'controller','action','seq','power','playerName','updatedAt'
            ])
            && (request.resource.data.controller == request.auth.uid
              // The current phone may release the room when it leaves.
              || (resource.data.controller == request.auth.uid
                && request.resource.data.controller == ''
                && request.resource.data.action == 'leave'))
            && request.resource.data.seq is int
            && request.resource.data.seq == resource.data.seq + 1
            && request.resource.data.action in [
              'ready','start','jump','submit','skip','leave'
            ]
            && request.resource.data.power is number
            && request.resource.data.power >= 0
            && request.resource.data.power <= 1
            && request.resource.data.playerName is string
            && request.resource.data.playerName.size() <= 12
            && request.resource.data.updatedAt == request.time)
        );
    }

    // ── Pinky Jump experimental shared Top 10; submitted scores are not server-verified.
    match /pinky_jump_scores/{entry} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 10;
      allow update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name','score','owner','createdAt'])
        && request.resource.data.keys().hasAll(['name','score','owner','createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 9999999
        && request.resource.data.createdAt == request.time;
    }
  }
}
